# Preencha com as credenciais reais.
# Nunca compartilhe este arquivo (renomeado .env) nem cole essas chaves em chat, email, etc.
#
# Local (teste no seu PC): copie pra ".env" e preencha.
# Render (producao): NAO sobe o .env pro Git - essas mesmas variaveis vao
# direto no painel do Render (Settings > Environment), uma por uma.

# --- Credenciais Omie ---
# Onde encontrar: no Omie, va em Configuracoes > API > Gerar chaves.
# Conta sem API separada: deixe os dois campos dela em branco - os
# modulos pulam ela automaticamente e avisam no log.

# --- Matriz (Frutamix) ---
OMIE_APP_KEY_MATRIZ=
OMIE_APP_SECRET_MATRIZ=

# --- Filial DF ---
OMIE_APP_KEY_FILIAL_DF=
OMIE_APP_SECRET_FILIAL_DF=

# --- Filial JSL ---
OMIE_APP_KEY_FILIAL_JSL=
OMIE_APP_SECRET_FILIAL_JSL=

# --- Pura Fruta ---
OMIE_APP_KEY_PURA_FRUTA=
OMIE_APP_SECRET_PURA_FRUTA=

# --- Frozen Log ---
OMIE_APP_KEY_FROZEN_LOG=
OMIE_APP_SECRET_FROZEN_LOG=

# --- EasyIce ---
OMIE_APP_KEY_EASYICE=
OMIE_APP_SECRET_EASYICE=

# --- Envio de email (SMTP) ---
# Gmail/Google Workspace: SMTP_USER = o email que envia, SMTP_PASSWORD =
# uma SENHA DE APP gerada em myaccount.google.com/apppasswords (NAO a
# senha normal da conta - Gmail bloqueia login de app comum por SMTP).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Opcional - se vazio, usa SMTP_USER como remetente.
SMTP_FROM=

# Quem recebe o relatorio todo dia, separados por virgula.
EMAIL_TO=chico@easyice.com.br,financeiro@easyice.com.br

# --- Seguranca do webhook ---
# Qualquer string longa/aleatoria sua (ex: gerada em
# https://www.uuidgenerator.net) - o GitHub Actions manda ela no header
# X-Webhook-Secret pra provar que quem chamou o /webhook/fluxo-caixa foi
# o disparo agendado, nao qualquer um passando na internet.
FLUXO_CAIXA_WEBHOOK_SECRET=
